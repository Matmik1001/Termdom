{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/home/mathews/.config/fastfetch/assets/jedi.png",
    "type": "iterm",
    "width": 30,
    "height": 15,
    "padding": {
      "top": 1,
      "left": 2
    }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    {
      "type": "title",
      "key": "",
      "keyColor": "cyan"
    },
    {
      "type": "separator"
    },
    "break",
    {
      "type": "custom",
      "format": "╭─➤  HARDWARE ⮜─────────────────────────────────────────────╮",
      "outputColor": "cyan"
    },
    {
      "type": "custom",
      "format": "╰─┬──────────────────────────────────────────────────────────╯",
      "outputColor": "cyan"
    },
    {
      "type": "host",
      "outputColor": "yellow",
      "key": "  ├ ",
      "keyColor": "cyan"
    },
    {
      "type": "chassis",
      "outputColor": "yellow",
      "key": "  ├ ",
      "keyColor": "cyan"
    },
    {
