      "key": "  ├ ",
      "keyColor": "cyan"
    },
    {
      "type": "memory",
      "outputColor": "yellow",
      "key": "  ├ ",
      "keyColor": "cyan"
    },
    {
      "type": "swap",
      "outputColor": "yellow",
      "key": "  ├ ",
      "keyColor": "cyan"
    },
    {
      "type": "disk",
